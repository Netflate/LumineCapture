[Custom Commands][net.local.lumine-capture.desktop]
Exec=lumine-capture
Name=Take full workspace screenshot with gui 

[Custom Commands][net.local.lumine-capture-2.desktop]
Exec=lumine-capture -f -t s
Name=Take a full workspace screenshot and save it immediately (no gui)

[Custom Commands][net.local.lumine-capture-3.desktop]
Exec=lumine-capture -f -t c
Name=Take a full workspace screenshot and save it to clipboard (no gui)

[Custom Commands][net.local.lumine-capture-4.desktop]
Exec=lumine-capture -r
Name=Drag a region and take the screenshot immediately (file + clipboard)

[net.local.lumine-capture.desktop][Global Shortcuts]
_launch=Print

[net.local.lumine-capture-2.desktop][Global Shortcuts]
_launch=Shift+Print

[net.local.lumine-capture-3.desktop][Global Shortcuts]
_launch=Ctrl+Shift+Print

[net.local.lumine-capture-4.desktop][Global Shortcuts]
_launch=Ctrl+Print
